# Copy to .env.local, replace every placeholder, and use separate keys per environment.
# Never commit real credentials or production connection strings.

# Neon pooled connection used by the application.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT/DB_NAME?sslmode=require

# Optional direct connection for trusted schema migration/admin scripts only.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT/DB_NAME?sslmode=require

# Full origin of the app. Use your preview URL in preview environments.
APP_URL=http://localhost:3000

# Required to encrypt and fingerprint syndicate membership numbers (32 bytes / 64 hex chars each).
# Generate distinct random values with: npm run secrets:generate
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
MEMBERSHIP_HMAC_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Optional email delivery (Resend). Email links are disabled without these values.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Web Push (VAPID) for notifications. Generate a key pair; never commit its private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=http://localhost:3000
