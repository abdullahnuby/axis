# AXIS local environment template.
# Copy this file to .env.local and replace values locally.
# Never commit .env.local or real credentials.

# Neon pooled connection for app traffic.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT/neondb?sslmode=require
# Optional direct connection for schema migrations and admin setup.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT/neondb?sslmode=require

# Generate two different 32-byte keys with: npm run secrets:generate
# Do not reuse one key for both purposes or rotate either without a migration plan.
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
MEMBERSHIP_HMAC_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Canonical origin; use your deployed HTTPS URL in Vercel.
APP_URL=http://localhost:3000

# Optional transactional email (Resend); requires a verified sender.
RESEND_API_KEY=
EMAIL_FROM=

# Required only when creating the initial administrator with npm run admin:create.
# Do not keep ADMIN_PASSWORD as a permanent production environment variable.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=

# Optional web push; generate a VAPID key pair before enabling push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
