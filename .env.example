# Copy to .env.local and fill in values for your own environment.
# Never commit real credentials or production connection strings.

# Neon pooled connection used by the application.
DATABASE_URL=

# Optional direct connection for trusted schema migration/admin scripts only.
DATABASE_URL_UNPOOLED=

# Full origin of the app. Use your preview URL in preview environments.
APP_URL=http://localhost:3000

# Optional email delivery (Resend). Email links are disabled without these values.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Web Push (VAPID) for notifications.
# Generate your own key pair; never use a production private key in a public repository.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=http://localhost:3000
